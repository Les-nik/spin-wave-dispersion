// Spin-wave dispersion of a thin in-plane magnetized film (Damon-Eshbach geometry)
//
// Run:          mumax3 film_dispersion.mx3
// Postprocess:  python -m swdispersion film_dispersion.out --component z --fmax 25 --kmax 120
//
// Idea: excite all wavenumbers up to k_cut and all frequencies up to f_cut at
// once with a short pulse that is a sinc in both space and time, record m(t)
// in every cell, and Fourier transform over (t, x). The spectrum of a sinc is
// flat up to its cut-off, so every mode inside that window is excited.

// ---- Geometry --------------------------------------------------------------
Nx := 1024
Ny := 4
Nz := 1
cx := 10e-9
cy := 10e-9
cz := 30e-9              // one cell across the 30 nm thickness

SetGridSize(Nx, Ny, Nz)
SetCellSize(cx, cy, cz)
SetPBC(8, 256, 0)        // periodic copies in x and y: an extended film

// ---- Material (permalloy-like) ---------------------------------------------
Msat  = 800e3
Aex   = 13e-12
alpha = 0.001            // low damping so the waves live through the whole run

// ---- Static state ----------------------------------------------------------
B0 := 50e-3
B_ext = vector(0, B0, 0) // field along y, waves along x: k perpendicular to M
m = uniform(0, 1, 0.01)
relax()
saveAs(m, "m_ground")    // not matched by m000000.ovf, so the reader skips it

// ---- Excitation ------------------------------------------------------------
f_cut := 40e9            // highest excited frequency (Hz)
k_cut := 150e6           // highest excited wavenumber (rad/m)
t_sampl := 0.5 / (f_cut * 1.1)   // sampling rate 2.2 f_cut, a bit above Nyquist
t0 := t + 10 / f_cut     // pulse centre, late enough that the sinc starts near zero

// Spatial part: sinc(k_cut x), centred in the film. MuMax3 coordinates from
// index2coord are measured from the centre of the grid.
mask := newVectorMask(Nx, Ny, Nz)
for i := 0; i < Nx; i++ {
	x := index2coord(i, 0, 0).X()
	for j := 0; j < Ny; j++ {
		for k := 0; k < Nz; k++ {
			mask.setVector(i, j, k, vector(0, 0, sinc(k_cut*x)))
		}
	}
}
// Temporal part: 1 mT amplitude, sinc in time.
B_ext.add(mask, 1e-3*sinc(2*pi*f_cut*(t-t0)))

// ---- Record ----------------------------------------------------------------
// 1000 samples give a frequency resolution of 1 / (1000 t_sampl) ~ 88 MHz.
// Output size: Nx*Ny*Nz*3 floats * 4 B * 1000 files ~ 50 MB.
autosave(m, t_sampl)
run(1000 * t_sampl)
